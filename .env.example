# ==============================================================================
# LUNAR HABITAT V2.1 — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server Port
PORT=8081
SPRING_PROFILES_ACTIVE=prod

# Production Database (MySQL 8.0+ / AWS RDS / GCP Cloud SQL / Aiven / Railway)
DB_URL=jdbc:mysql://lunar-mysql-prod.internal:3306/lunar_habitat?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=lunar_mission_admin
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Security & Cryptographic Tokens (Must be a 256-bit cryptographically secure secret)
JWT_SECRET=YOUR_64_CHAR_HEX_OR_BASE64_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_KEY_HERE_2026

# Production Allowed Origins (Comma-separated for multi-domain support)
FRONTEND_URL=https://jagetheswaren.github.io,https://lunar-habitat.pages.dev

