# ==============================================================================
# LUNAR HABITAT V2.1 — FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Backend API Gateway URL (e.g. Cloudflare Tunnel, AWS API Gateway, Fly.io, Railway)
# Leave empty or set to / in production when behind a unified reverse proxy/CDN
VITE_API_URL=https://api.lunar-habitat.example.com

# Realtime WebSocket stream URL
VITE_WS_URL=wss://api.lunar-habitat.example.com/ws

# Demo Credentials in Login UI (Set to false or omit in production builds to hide)
VITE_ENABLE_DEMO_CREDENTIALS=false

# Optional custom base path (e.g. for GitHub Pages: /lunar-habitat-environmental-control/)
VITE_BASE_PATH=/

